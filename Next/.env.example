# https://openrouter.ai/keys 에서 발급
OPENROUTER_API_KEY=your-api-key-here

# 생략하면 nvidia/nemotron-3-ultra-550b-a55b:free 사용
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# 필요할 때만 기본 엔드포인트 덮어쓰기
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AI 연결 선택 (dev 스크립트 인자로 넘기면 이 값보다 우선)
# LINK=genkit

# 디버그 패널(원본 응답 보기·연결 표시). true/false 강제, 생략 시 dev 표시·prod 숨김
# NEXT_PUBLIC_SHOW_DEBUG=true
